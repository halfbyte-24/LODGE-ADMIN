[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[remote "origin"]
	url = https://github.com/halfbyte-24/LODGE-CUSTOMER.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "lodge-customer-integration"]
	remote = origin
	merge = refs/heads/lodge-customer-integration
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
