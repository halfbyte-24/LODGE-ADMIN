# =============================================================
# AMONTRON HOTEL & RESTAURANT — Environment Variables Template
# =============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# This file (.env.example) is safe to push to GitHub.
# =============================================================

# Supabase Project URL
# Get this from: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (safe for frontend)
# Get this from: Supabase Dashboard → Settings → API → Publishable (anon) key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
